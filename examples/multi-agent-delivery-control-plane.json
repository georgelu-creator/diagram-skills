      {"label": "规划任务", "subtitle": "拆解与依赖", "icon": "layers"},
      {"label": "并行实现", "subtitle": "代码与迁移", "icon": "code"},
      {"label": "独立验证", "subtitle": "测试与安全", "icon": "test"},
      {"label": "人工审批", "subtitle": "高风险门禁", "icon": "user"},
      {"label": "渐进发布", "subtitle": "Canary / Rollback", "icon": "cloud"},
      {"label": "复盘学习", "subtitle": "证据沉淀", "icon": "brain"}
