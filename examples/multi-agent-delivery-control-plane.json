    {"source": "customer", "target": "delivery-router", "kind": "primary"},
    {"source": "incident", "target": "delivery-router", "kind": "error"},
    {"source": "tech-debt", "target": "delivery-router", "kind": "async"},
    {"source": "policy-change", "target": "delivery-router", "kind": "control"},
