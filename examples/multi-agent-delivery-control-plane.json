    {"label": "职责分离", "subtitle": "实现与独立验证角色分开", "icon": "user"},
    {"label": "失败可恢复", "subtitle": "超时、重试、回滚路径明确", "icon": "sync"},
    {"label": "持续学习", "subtitle": "复盘转化为规则与记忆", "icon": "brain"}
