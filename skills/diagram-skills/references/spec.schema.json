{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/georgelu-creator/diagram-skills/blob/main/skills/diagram-skills/references/spec.schema.json",
  "title": "DiagramSpec diagram",
  "type": "object",
  "additionalProperties": false,
  "required": ["title"],
  "allOf": [
    {
      "if": {"properties": {"layout": {"const": "board"}}, "required": ["layout"]},
      "then": {"required": ["diagram_type", "sections"]},
      "else": {"required": ["nodes", "edges"]}
    }
  ],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string"},
    "diagram_type": {
      "type": "string",
      "enum": ["system-architecture", "agent-workflow", "data-flow", "capability-map", "user-flow", "system-topology", "decision-tree", "roadmap", "strategy-map", "process-flow"],
      "default": "process-flow"
    },
    "direction": {"type": "string", "enum": ["LR", "TB"], "default": "LR"},
    "layout": {"type": "string", "enum": ["graph", "board"], "default": "graph"},
    "theme": {"type": "string", "enum": ["paper", "notion", "spectrum", "blueprint", "terminal"], "default": "paper"},
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "primary": {"$ref": "#/$defs/color"},
        "accent": {"$ref": "#/$defs/color"},
        "page": {"$ref": "#/$defs/color"},
        "surface": {"$ref": "#/$defs/color"},
        "ink": {"$ref": "#/$defs/color"},
        "muted": {"$ref": "#/$defs/color"},
        "hair": {"$ref": "#/$defs/color"},
        "group": {"$ref": "#/$defs/color"},
        "group_stroke": {"$ref": "#/$defs/color"}
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/boardSection"}
    },
    "connections": {
      "type": "array",
      "items": {"$ref": "#/$defs/boardConnection"}
    },
    "flow": {"$ref": "#/$defs/boardFlow"},
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/boardItem"}
    },
    "legend": {"type": "boolean"},
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "label": {"type": "string", "minLength": 1}
        }
      }
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "label": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 0}
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "label": {"type": "string", "minLength": 1},
          "subtitle": {"type": "string"},
          "type": {"type": "string", "enum": ["process", "decision", "input", "document", "database", "agent", "external"], "default": "process"},
          "group": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "lane": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "rank": {"type": "integer", "minimum": 0},
          "child_view": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "link": {"type": "string"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target"],
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"},
          "label": {"type": "string"},
          "kind": {"type": "string", "enum": ["primary", "control", "feedback", "async", "success", "error"], "default": "primary"}
        }
      }
    }
  },
  "$defs": {
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "boardIcon": {
      "type": "string",
      "enum": ["agent", "api", "archive", "brain", "calendar", "chat", "check", "cloud", "code", "database", "desktop", "document", "folder", "gateway", "graph", "image", "laptop", "layers", "lock", "mail", "metrics", "model", "note", "phone", "prompt", "robot", "schema", "search", "shield", "spark", "stream", "sync", "terminal", "test", "user"]
    },
    "boardItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string"},
        "icon": {"$ref": "#/$defs/boardIcon"}
      }
    },
    "boardCard": {
      "allOf": [
        {"$ref": "#/$defs/boardItem"},
        {"type": "object", "required": ["id"]}
      ]
    },
    "boardBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"type": "string", "enum": ["grid", "banner", "list"]},
        "title": {"type": "string"},
        "subtitle": {"type": "string"},
        "icon": {"$ref": "#/$defs/boardIcon"},
        "span": {"type": "integer", "minimum": 1, "maximum": 8},
        "columns": {"type": "integer", "minimum": 1, "maximum": 7},
        "cards": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/boardCard"}},
        "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "footer": {"type": "string"}
      }
    },
    "boardSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "tone", "blocks"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string"},
        "tone": {"type": "string", "enum": ["blue", "purple", "green", "orange", "teal", "slate", "amber"]},
        "blocks": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/boardBlock"}}
      }
    },
    "boardConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/id"},
        "label": {"type": "string"},
        "kind": {"type": "string", "enum": ["primary", "control", "feedback", "async", "success", "error"]},
        "bidirectional": {"type": "boolean"}
      }
    },
    "boardFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "steps"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "tone": {"type": "string", "enum": ["blue", "purple", "green", "orange", "teal", "slate", "amber"]},
        "steps": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/boardItem"}}
      }
    }
  }
}
