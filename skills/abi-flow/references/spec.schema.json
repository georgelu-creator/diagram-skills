{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/georgelu-creator/abi-flow/blob/main/skills/abi-flow/references/spec.schema.json",
  "title": "ABI Flow diagram",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "nodes", "edges"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string"},
    "diagram_type": {
      "enum": ["system-architecture", "agent-workflow", "data-flow", "capability-map", "user-flow", "system-topology", "decision-tree", "roadmap", "strategy-map", "process-flow"],
      "default": "process-flow"
    },
    "direction": {"enum": ["LR", "TB"], "default": "LR"},
    "theme": {"enum": ["paper", "notion", "spectrum", "blueprint", "terminal"], "default": "paper"},
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "primary": {"$ref": "#/$defs/color"},
        "accent": {"$ref": "#/$defs/color"},
        "page": {"$ref": "#/$defs/color"},
        "surface": {"$ref": "#/$defs/color"},
        "ink": {"$ref": "#/$defs/color"},
        "muted": {"$ref": "#/$defs/color"},
        "hair": {"$ref": "#/$defs/color"},
        "group": {"$ref": "#/$defs/color"},
        "group_stroke": {"$ref": "#/$defs/color"}
      }
    },
    "legend": {"type": "boolean"},
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "label": {"type": "string", "minLength": 1}
        }
      }
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "label": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 0}
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "label": {"type": "string", "minLength": 1},
          "subtitle": {"type": "string"},
          "type": {"enum": ["process", "decision", "input", "document", "database", "agent", "external"], "default": "process"},
          "group": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "lane": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "rank": {"type": "integer", "minimum": 0},
          "child_view": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
          "link": {"type": "string"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target"],
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"},
          "label": {"type": "string"},
          "kind": {"enum": ["primary", "control", "feedback", "async", "success", "error"], "default": "primary"}
        }
      }
    }
  },
  "$defs": {
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"}
  }
}
