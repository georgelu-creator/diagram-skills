{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/georgelu-creator/abi-flow/blob/main/skills/abi-flow/references/workspace.schema.json",
  "title": "DiagramSpec multi-view workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "entry_view", "views"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "3.0"},
    "title": {"type": "string", "minLength": 1},
    "entry_view": {"$ref": "#/$defs/id"},
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {"oneOf": [{"$ref": "#/$defs/visualspecView"}, {"$ref": "#/$defs/mermaidView"}]}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"},
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "primary": {"$ref": "#/$defs/color"},
        "accent": {"$ref": "#/$defs/color"},
        "page": {"$ref": "#/$defs/color"},
        "surface": {"$ref": "#/$defs/color"},
        "ink": {"$ref": "#/$defs/color"},
        "muted": {"$ref": "#/$defs/color"},
        "hair": {"$ref": "#/$defs/color"},
        "group": {"$ref": "#/$defs/color"},
        "group_stroke": {"$ref": "#/$defs/color"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string"},
        "type": {"enum": ["process", "decision", "input", "document", "database", "agent", "external"]},
        "group": {"$ref": "#/$defs/id"},
        "lane": {"$ref": "#/$defs/id"},
        "rank": {"type": "integer", "minimum": 0},
        "child_view": {"$ref": "#/$defs/id"},
        "link": {"type": "string"},
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {"x": {"type": "number"}, "y": {"type": "number"}}
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "source": {"$ref": "#/$defs/id"},
        "target": {"$ref": "#/$defs/id"},
        "label": {"type": "string"},
        "kind": {"enum": ["primary", "control", "feedback", "async", "success", "error"]}
      }
    },
    "visualspecView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "format", "title", "nodes", "edges"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "format": {"const": "visualspec"},
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string"},
        "diagram_type": {"enum": ["system-architecture", "agent-workflow", "data-flow", "capability-map", "user-flow", "system-topology", "decision-tree", "roadmap", "strategy-map", "process-flow"]},
        "direction": {"enum": ["LR", "TB"]},
        "theme": {"enum": ["paper", "notion", "spectrum", "blueprint", "terminal"]},
        "brand": {"$ref": "#/$defs/brand"},
        "layout_mode": {"enum": ["auto", "ranked", "manual"]},
        "legend": {"type": "boolean"},
        "groups": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1}}}},
        "lanes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"type": "string", "minLength": 1}, "order": {"type": "integer", "minimum": 0}}}},
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
      }
    },
    "mermaidView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "format", "title", "source"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "format": {"const": "mermaid"},
        "title": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}
      }
    }
  }
}
